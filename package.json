{
  "name": "gathergrid",
  "version": "0.1.0",
  "private": true,
  "description": "GatherGrid — city-wide activity platform",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:ci": "npm run test:ci --workspaces --if-present",
    "dev:server": "npm run dev -w server",
    "dev:participant": "npm run dev -w apps/participant-web",
    "dev:organizer": "npm run dev -w apps/organizer-web",
    "dev:admin": "npm run dev -w apps/admin-web",
    "dev:frontend": "concurrently -n \"participant,organizer,admin\" -c \"cyan,magenta,yellow\" \"npm run dev:participant\" \"npm run dev:organizer\" \"npm run dev:admin\"",
    "dev:frontends": "npm run dev:frontend",
    "dev:all": "concurrently -n \"server,participant,organizer,admin\" -c \"green,cyan,magenta,yellow\" \"npm run dev:server\" \"npm run dev:participant\" \"npm run dev:organizer\" \"npm run dev:admin\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.22",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^10.0.6",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "msw": "^2.15.0",
    "prettier": "^3.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
