{
  "name": "@gathergrid/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, types, enums, and constants",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@gathergrid/config": "*",
    "eslint": "^10.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
