# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
# Get from: Atlas dashboard → your cluster → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/gathergrid?retryWrites=true&w=majority

LOG_LEVEL=debug

# ── JWT (change both to long random strings in production) ──
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── SMTP (optional in dev – console transport used if not set) ─────
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── Geocoding ──────────────────────────────────────────
GEOCODE_USER_AGENT=GatherGrid/1.0
